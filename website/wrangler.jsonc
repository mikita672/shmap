{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shmap-website",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "routes": [
    {
      "pattern": "shmap.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "API_BASE_URL": "https://shmap-backend-761707913997.europe-central2.run.app"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/u/*"
    ]
  }
}