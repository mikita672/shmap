# --- Local development (docker-compose) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=shmapdb
JWT_SECRET=your_jwt_secret_min_256_bits_here

RESEND_API_KEY=your_resend_api_key

GOOGLE_CLIENT_ID=your-local-dev-client-id.apps.googleusercontent.com

B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=shmap-avatars-dev
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
STORAGE_PUBLIC_BASE_URL=https://shmap-avatars-dev.s3.eu-central-003.backblazeb2.com

# --- Cloud Run / Production (set via GCP Secret Manager, not .env) ---
# DB_URL=jdbc:postgresql://ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_USER=neondb_owner
# DB_PASSWORD=your_neon_password
